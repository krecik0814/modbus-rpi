{
  "name": "Eltako DSZ15DZMOD",
  "manufacturer": "Eltako",
  "model": "DSZ15DZMOD / DSZ16 (format danych integer)",
  "description": "Dwukierunkowy licznik 3-fazowy MID z Modbus RTU. Rejestry input FC04, liczby całkowite 32-bit big-endian: napięcie, prąd i energia z rozdzielczością 0,01, cos φ 0,001, moc w W ze znakiem. Zestaw wspólny z serią DSZ16 (tam wymagany format danych integer, rejestr holding 0x001E = 0); więcej wielkości dla DSZ16 zawiera preset Eltako DSZ16.",
  "phases": 3,
  "source": "mbmd meters/rs485/eltako.go (github.com/volkszaehler/mbmd); Eltako Modbus-RTU protocol specification V3.7.3 (DSZ15DZMOD/DSZ16/WSZ16; typy danych, ustawienia portu): https://nettbutikk.mwg.no/media/multicase/documents/dsz16_eltako_modbus-rtu_specification_v3.7.3.pdf",
  "register_type": "input",
  "byte_order": "ABCD",
  "data_type": "uint32",
  "serial": {"baudrate": 9600, "parity": "N", "stopbits": 1},
  "probe": "voltage_l1",
  "registers": {
    "voltage_l1":    {"address": 0, "scale": 0.01, "label": "Napięcie L1", "unit": "V", "group": "voltage", "decimals": 1},
    "voltage_l2":    {"address": 2, "scale": 0.01, "label": "Napięcie L2", "unit": "V", "group": "voltage", "decimals": 1},
    "voltage_l3":    {"address": 4, "scale": 0.01, "label": "Napięcie L3", "unit": "V", "group": "voltage", "decimals": 1},
    "current_l1":    {"address": 6, "scale": 0.01, "label": "Prąd L1", "unit": "A", "group": "current", "decimals": 2},
    "current_l2":    {"address": 8, "scale": 0.01, "label": "Prąd L2", "unit": "A", "group": "current", "decimals": 2},
    "current_l3":    {"address": 10, "scale": 0.01, "label": "Prąd L3", "unit": "A", "group": "current", "decimals": 2},
    "power_l1":      {"address": 12, "type": "int32", "label": "Moc czynna L1", "unit": "W", "group": "power", "decimals": 0},
    "power_l2":      {"address": 14, "type": "int32", "label": "Moc czynna L2", "unit": "W", "group": "power", "decimals": 0},
    "power_l3":      {"address": 16, "type": "int32", "label": "Moc czynna L3", "unit": "W", "group": "power", "decimals": 0},
    "pf_l1":         {"address": 30, "type": "int32", "scale": 0.001, "label": "cos φ L1", "unit": "", "group": "pf", "decimals": 3},
    "pf_l2":         {"address": 32, "type": "int32", "scale": 0.001, "label": "cos φ L2", "unit": "", "group": "pf", "decimals": 3},
    "pf_l3":         {"address": 34, "type": "int32", "scale": 0.001, "label": "cos φ L3", "unit": "", "group": "pf", "decimals": 3},
    "power_total":   {"address": 52, "type": "int32", "label": "Moc czynna Σ", "unit": "W", "group": "total", "decimals": 0},
    "pf_total":      {"address": 62, "type": "int32", "scale": 0.001, "label": "cos φ Σ", "unit": "", "group": "pf", "decimals": 3},
    "energy_import": {"address": 72, "scale": 0.01, "label": "Energia pobrana", "unit": "kWh", "group": "energy", "decimals": 2},
    "energy_export": {"address": 74, "scale": 0.01, "label": "Energia oddana", "unit": "kWh", "group": "energy", "decimals": 2}
  }
}
