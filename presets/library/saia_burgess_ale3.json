    "power_l1":         {"address": 37, "scale": 10, "label": "Moc czynna L1", "unit": "W", "group": "power", "decimals": 0},
    "reactive_l1":      {"address": 38, "type": "int16", "scale": 10, "label": "Moc bierna L1", "unit": "var", "group": "power", "decimals": 0},
    "pf_l1":            {"address": 39, "scale": 0.01, "label": "cos φ L1", "unit": "", "group": "pf", "decimals": 3},
    "voltage_l2":       {"address": 40, "label": "Napięcie L2", "unit": "V", "group": "voltage", "decimals": 1},
