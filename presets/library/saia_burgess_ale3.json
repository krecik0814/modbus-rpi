{
  "name": "Saia Burgess ALE3",
  "manufacturer": "Saia Burgess Controls",
  "model": "ALE3D5FD10C2A00 / ALE3D5FD10C3A00 (MID)",
  "description": "Licznik 3-fazowy 65 A z Modbus RTU i dwiema taryfami. Tylko FC03, liczby całkowite 16-bit (energia 32-bit) ze skalą: prąd 0,1 A, moc 0,01 kW, energia 0,01 kWh; maks. 20 rejestrów w jednym zapytaniu, dane odświeżane co 10 s, prędkość i parzystość (8E1, 8O1 lub 8N2) wykrywane automatycznie. Energia to liczniki taryf T1 i T2 zgodnie z kartą katalogową (mbmd odczytuje je jako energię pobraną i oddaną).",
  "phases": 3,
  "source": "mbmd meters/rs485/sbc.go (github.com/volkszaehler/mbmd); karta katalogowa SBC 26-527 ALE3 z Modbus (rejestry, limit 20 rejestrów): https://sbc-support.com/uploads/tx_srcproducts/26-527_ENG_DS_EnergyMeter-ALE3-with-Modbus_01.pdf",
  "register_type": "holding",
  "byte_order": "ABCD",
  "data_type": "uint16",
  "read": {"max_block": 20},
  "probe": "voltage_l1",
  "registers": {
    "energy_import_t1": {"address": 27, "type": "uint32", "scale": 0.01, "label": "Energia pobrana T1", "unit": "kWh", "group": "energy", "decimals": 2},
    "energy_import_t2": {"address": 31, "type": "uint32", "scale": 0.01, "label": "Energia pobrana T2", "unit": "kWh", "group": "energy", "decimals": 2},
    "voltage_l1":       {"address": 35, "label": "Napięcie L1", "unit": "V", "group": "voltage", "decimals": 1},
