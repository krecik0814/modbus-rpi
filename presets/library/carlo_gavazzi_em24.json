{
  "name": "Carlo Gavazzi EM24-DIN",
  "manufacturer": "Carlo Gavazzi",
  "model": "EM24-DIN AV9 / AV0 / AV5 / AV6 z portem RS485 (starszy protokół EM24-DIN v2)",
  "description": "Licznik 3-fazowy z RS485 (Modbus RTU); wartości INT32 z młodszym słowem pierwszym (CDAB) i mnożnikami (V x10, A x1000, W x10, kWh x10), funkcje 03 i 04 działają identycznie. Licznik przyjmuje maks. 11 rejestrów w jednym zapytaniu; transmisja 9600 lub 4800 bod, zawsze bez parzystości i z 1 bitem stopu. Energia pobrana pochodzi z licznika całkowitego 0x3E; mbmd czyta kasowalny licznik częściowy 0x42, dostępny tu jako energy_import_partial.",
  "phases": 3,
  "source": "mbmd meters/rs485/carlogavazzi-em24.go (github.com/volkszaehler/mbmd); Carlo Gavazzi EM24-DIN Communication Protocol v2 rev 0 (2007): https://www.ccontrols.com/support/dp/CarloGavazziEM24.pdf",
  "register_type": "input",
  "byte_order": "CDAB",
  "data_type": "int32",
  "read": {"max_block": 11},
  "probe": "voltage_l1",
