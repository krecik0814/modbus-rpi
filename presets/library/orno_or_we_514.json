    "energy_reactive_total_t1": {"address": 40992, "scale": 0.01, "label": "Energia bierna całkowita T1", "unit": "kvarh", "group": "energy", "decimals": 2},
    "energy_reactive_total_t2": {"address": 40994, "scale": 0.01, "label": "Energia bierna całkowita T2", "unit": "kvarh", "group": "energy", "decimals": 2}
