    "reactive_l1":              {"address": 328, "type": "int32", "label": "Moc bierna L1", "unit": "var", "group": "power", "decimals": 0},
    "apparent_l1":              {"address": 336, "type": "int32", "label": "Moc pozorna L1", "unit": "VA", "group": "power", "decimals": 0},
    "pf_l1":                    {"address": 344, "type": "int16", "scale": 0.001, "label": "cos φ L1", "unit": "", "group": "pf", "decimals": 3},
