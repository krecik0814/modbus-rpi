{
  "name": "Bernecker Engineering MPM3PM",
  "manufacturer": "Bernecker Engineering",
  "model": "MPM3PM",
  "description": "Kompaktowy licznik 3-fazowy (4 moduły) z RS-485 Modbus. Rejestry holding FC03, liczby całkowite 32-bit big-endian ze skalowaniem; cos φ odczytywany bez znaku. Mapa rejestrów pochodzi z mbmd (dokumentacja producenta była niedostępna); adresy i skalowanie napięć, prądów, mocy czynnych, cos φ faz, częstotliwości i energii pobranej/oddanej potwierdza niezależna implementacja openWB (czyta je funkcją FC04).",
  "phases": 3,
  "source": "mbmd meters/rs485/mpm3pm.go (github.com/volkszaehler/mbmd), na podstawie http://www.qrck.info/MPM3PModBus.pdf; zgodne adresy i skalowanie U, I, P, cos φ L1-L3, f, energii pobranej/oddanej: openWB packages/modules/common/mpm3pm.py (github.com/openWB/core)",
  "register_type": "holding",
  "byte_order": "ABCD",
  "data_type": "uint32",
  "probe": "voltage_l1",
  "registers": {
    "energy_total":          {"address": 0, "type": "int32", "scale": 0.01, "label": "Energia całkowita", "unit": "kWh", "group": "energy", "decimals": 2},
    "energy_import":         {"address": 2, "scale": 0.01, "label": "Energia pobrana", "unit": "kWh", "group": "energy", "decimals": 2},
    "energy_export":         {"address": 4, "scale": 0.01, "label": "Energia oddana", "unit": "kWh", "group": "energy", "decimals": 2},
    "energy_reactive_total": {"address": 6, "scale": 0.01, "label": "Energia bierna całkowita", "unit": "kvarh", "group": "energy", "decimals": 2},
    "voltage_l1":            {"address": 8, "scale": 0.1, "label": "Napięcie L1", "unit": "V", "group": "voltage", "decimals": 1},
    "voltage_l2":            {"address": 10, "scale": 0.1, "label": "Napięcie L2", "unit": "V", "group": "voltage", "decimals": 1},
    "voltage_l3":            {"address": 12, "scale": 0.1, "label": "Napięcie L3", "unit": "V", "group": "voltage", "decimals": 1},
    "current_l1":            {"address": 14, "scale": 0.01, "label": "Prąd L1", "unit": "A", "group": "current", "decimals": 2},
    "current_l2":            {"address": 16, "scale": 0.01, "label": "Prąd L2", "unit": "A", "group": "current", "decimals": 2},
    "current_l3":            {"address": 18, "scale": 0.01, "label": "Prąd L3", "unit": "A", "group": "current", "decimals": 2},
    "power_l1":              {"address": 20, "type": "int32", "scale": 0.01, "label": "Moc czynna L1", "unit": "W", "group": "power", "decimals": 0},
    "power_l2":              {"address": 22, "type": "int32", "scale": 0.01, "label": "Moc czynna L2", "unit": "W", "group": "power", "decimals": 0},
    "power_l3":              {"address": 24, "type": "int32", "scale": 0.01, "label": "Moc czynna L3", "unit": "W", "group": "power", "decimals": 0},
    "reactive_l1":           {"address": 26, "type": "int32", "scale": 0.01, "label": "Moc bierna L1", "unit": "var", "group": "power", "decimals": 0},
    "reactive_l2":           {"address": 28, "type": "int32", "scale": 0.01, "label": "Moc bierna L2", "unit": "var", "group": "power", "decimals": 0},
    "reactive_l3":           {"address": 30, "type": "int32", "scale": 0.01, "label": "Moc bierna L3", "unit": "var", "group": "power", "decimals": 0},
    "pf_l1":                 {"address": 32, "scale": 0.001, "label": "cos φ L1", "unit": "", "group": "pf", "decimals": 3},
    "pf_l2":                 {"address": 34, "scale": 0.001, "label": "cos φ L2", "unit": "", "group": "pf", "decimals": 3},
    "pf_l3":                 {"address": 36, "scale": 0.001, "label": "cos φ L3", "unit": "", "group": "pf", "decimals": 3},
    "power_total":           {"address": 38, "type": "int32", "scale": 0.01, "label": "Moc czynna Σ", "unit": "W", "group": "total", "decimals": 0},
    "reactive_total":        {"address": 40, "type": "int32", "scale": 0.01, "label": "Moc bierna Σ", "unit": "var", "group": "total", "decimals": 0},
    "pf_total":              {"address": 42, "scale": 0.001, "label": "cos φ Σ", "unit": "", "group": "pf", "decimals": 3},
    "frequency":             {"address": 44, "scale": 0.01, "label": "Częstotliwość", "unit": "Hz", "group": "system", "decimals": 2}
  }
}
