{
  "name": "B+G e-tech WS100",
  "manufacturer": "B+G e-tech",
  "model": "WS100-1943 / WS100-19L3",
  "description": "Dwukierunkowy licznik 1-fazowy MID 100 A (1 moduł) z Modbus RTU; WS100-19L3 ma dodatkowo taryfy. Rejestry holding FC03, liczby całkowite big-endian ze skalą: napięcie i prąd 0,001, moc w W, częstotliwość 0,1 Hz, energia 0,01 kWh. W wersji bez taryf T1 = suma, a T2 = 0; sposób liczenia energii całkowitej ustawia się w liczniku.",
  "phases": 1,
  "source": "mbmd meters/rs485/ws100.go (github.com/volkszaehler/mbmd); karta katalogowa B+G e-tech WS100 z opisem rejestrów Modbus (rejestry, ustawienia portu): https://data.xn--stromzhler-v5a.eu/manuals/bg_ws100serie_de.pdf",
  "register_type": "holding",
  "byte_order": "ABCD",
  "data_type": "uint32",
  "serial": {"baudrate": 9600, "parity": "N", "stopbits": 1},
  "probe": "voltage_l1",
  "registers": {
    "voltage_l1":             {"address": 256, "scale": 0.001, "label": "Napięcie L1", "unit": "V", "group": "voltage", "decimals": 1},
    "current_l1":             {"address": 258, "type": "int32", "scale": 0.001, "label": "Prąd L1", "unit": "A", "group": "current", "decimals": 2},
    "power_l1":               {"address": 260, "type": "int32", "label": "Moc czynna L1", "unit": "W", "group": "power", "decimals": 0},
    "apparent_l1":            {"address": 262, "label": "Moc pozorna L1", "unit": "VA", "group": "power", "decimals": 0},
    "reactive_l1":            {"address": 264, "type": "int32", "label": "Moc bierna L1", "unit": "var", "group": "power", "decimals": 0},
    "frequency":              {"address": 266, "type": "uint16", "scale": 0.1, "label": "Częstotliwość", "unit": "Hz", "group": "system", "decimals": 2},
    "pf_l1":                  {"address": 267, "type": "int16", "scale": 0.001, "label": "cos φ L1", "unit": "", "group": "pf", "decimals": 3},
    "energy_import":          {"address": 270, "scale": 0.01, "label": "Energia pobrana", "unit": "kWh", "group": "energy", "decimals": 2},
    "energy_import_t1":       {"address": 272, "scale": 0.01, "label": "Energia pobrana T1", "unit": "kWh", "group": "energy", "decimals": 2},
    "energy_import_t2":       {"address": 274, "scale": 0.01, "label": "Energia pobrana T2", "unit": "kWh", "group": "energy", "decimals": 2},
    "energy_export":          {"address": 280, "scale": 0.01, "label": "Energia oddana", "unit": "kWh", "group": "energy", "decimals": 2},
    "energy_export_t1":       {"address": 282, "scale": 0.01, "label": "Energia oddana T1", "unit": "kWh", "group": "energy", "decimals": 2},
    "energy_export_t2":       {"address": 284, "scale": 0.01, "label": "Energia oddana T2", "unit": "kWh", "group": "energy", "decimals": 2},
    "energy_total":           {"address": 290, "scale": 0.01, "label": "Energia całkowita", "unit": "kWh", "group": "energy", "decimals": 2},
    "energy_reactive_import": {"address": 300, "scale": 0.01, "label": "Energia bierna pobrana", "unit": "kvarh", "group": "energy", "decimals": 2},
    "energy_reactive_export": {"address": 310, "scale": 0.01, "label": "Energia bierna oddana", "unit": "kvarh", "group": "energy", "decimals": 2},
    "energy_reactive_total":  {"address": 320, "scale": 0.01, "label": "Energia bierna całkowita", "unit": "kvarh", "group": "energy", "decimals": 2}
  }
}
